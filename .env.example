# Copy this file to .env and fill in your API keys (Never commit .env)
LUNA_API_KEY=your_experiential_labs_luna_key_here
LUNA_BASE_URL=https://api.experientiallabs.ai/v1
LUNA_MODEL=gpt-6-luna

GEMINI_API_KEY=your_google_ai_studio_gemini_key_here
GEMINI_MODEL=gemini-4-hydrogen

CF_ACCOUNT_ID=your_cloudflare_account_id_here
CF_API_TOKEN=your_cloudflare_api_token_here
FLUX_MODEL=@cf/black-forest-labs/flux-1-schnell
CF_LLM_MODEL=@cf/moonshotai/kimi-k2.7-code

ELEVENLABS_API_KEY=optional_elevenlabs_api_key_here
DEFAULT_VOICE=mark
